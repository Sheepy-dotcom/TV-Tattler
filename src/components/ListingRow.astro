---
import type { Article } from '../lib/relations';
import { formatDate, isoDate, kindLabel } from '../lib/format';

interface Props {
  article: Article;
  /** The show accent this row wears. Omitted → neutral ink bar. */
  accent?: string;
  /** Render the large lead treatment (used once, at the top of a stack). */
  lead?: boolean;
}

const { article, accent, lead = false } = Astro.props;
const { data } = article;
const href = `/articles/${article.id}/`;
---

<article
  class:list={['row', { 'row--lead': lead }]}
  style={accent ? `--accent: ${accent};` : undefined}
>
  <div class="row__bar" aria-hidden="true"></div>
  <div class="row__body">
    <div class="row__meta">
      <span class="chip chip--accent">{kindLabel(data.kind)}</span>
      {data.lead && lead === false && <span class="chip chip--live">Lead</span>}
      {data.spoiler && <span class="chip chip--spoiler">Spoiler</span>}
      <time class="mono" datetime={isoDate(data.publishedAt)}>
        {formatDate(data.publishedAt)}
      </time>
    </div>
    <h2 class="row__title">
      <a href={href}>{data.title}</a>
    </h2>
    <p class="row__standfirst">{data.standfirst}</p>
  </div>
</article>

<style>
  /* A listing row: a thick coloured left bar in the show's accent, then the
     text. The bar is the "what am I looking at" cue before the headline. */
  .row {
    display: grid;
    grid-template-columns: 6px 1fr;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .row:hover {
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }

  .row__bar {
    background: var(--accent, var(--ink));
  }

  .row__body {
    padding: var(--space-3) var(--space-4);
  }

  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .row__title {
    font-size: var(--step-1);
    margin: 0 0 var(--space-1);
  }
  .row__title a {
    text-decoration: none;
    color: var(--ink);
  }
  .row__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent, var(--live));
    text-decoration-thickness: 2px;
  }

  .row__standfirst {
    margin: 0;
    color: var(--ink-80);
    max-width: var(--measure);
  }

  /* ---- Lead treatment: one story, set large -------------------------- */
  .row--lead {
    grid-template-columns: 10px 1fr;
  }
  .row--lead .row__body {
    padding: var(--space-5) var(--space-5);
  }
  .row--lead .row__title {
    font-size: var(--step-3);
  }
  .row--lead .row__standfirst {
    font-size: var(--step-1);
    color: var(--ink);
  }

  @media (min-width: 40rem) {
    .row--lead {
      grid-template-columns: 14px 1fr;
    }
  }
</style>
