---
// A lightweight cookie-consent banner wired to Google Consent Mode v2.
//
// Renders only when ads are configured. Consent defaults to "denied" (set in the
// layout head), so no personalised-ad cookies are set until the visitor agrees.
// "Accept all" grants; "Reject" keeps non-personalised ads (allowed under consent
// mode). The choice is remembered in localStorage.
//
// NOTE ON COMPLIANCE: for fully-compliant personalised ads to UK/EEA visitors,
// Google requires a *certified* Consent Management Platform. The simplest route
// is to switch on Google's own "Privacy & messaging → GDPR message" inside your
// AdSense account (it's certified and shows automatically). This banner is a
// clean, working baseline and sets Consent Mode correctly; see docs/monetization.md.
import { adsEnabled } from '../config/site';
---

{
  adsEnabled && (
    <Fragment>
      <div id="consent" class="consent" role="dialog" aria-label="Cookie consent" hidden>
        <p class="consent__text">
          <strong>We value your privacy.</strong> TV&nbsp;Tattler uses cookies to show ads,
          which keep the site free to read. Choose <em>Accept all</em> for personalised ads,
          or <em>Reject</em> to see non-personalised ones instead. You can change your choice
          any time &mdash; see our <a href="/privacy/">Privacy&nbsp;&amp;&nbsp;Cookies policy</a>.
        </p>
        <div class="consent__actions">
          <button type="button" class="consent__btn consent__btn--ghost" data-consent="deny">
            Reject
          </button>
          <button type="button" class="consent__btn" data-consent="grant">
            Accept all
          </button>
        </div>
      </div>

      <script is:inline>
        (function () {
          var KEY = 'ttl-consent';
          function gtag() { window.dataLayer = window.dataLayer || []; window.dataLayer.push(arguments); }
          function init() {
            var el = document.getElementById('consent');
            if (!el) return;
            var stored = null;
            try { stored = localStorage.getItem(KEY); } catch (e) {}
            if (!stored) el.hidden = false;
            var btns = el.querySelectorAll('[data-consent]');
            for (var i = 0; i < btns.length; i++) {
              btns[i].addEventListener('click', function () {
                var granted = this.getAttribute('data-consent') === 'grant';
                var state = granted ? 'granted' : 'denied';
                try {
                  gtag('consent', 'update', {
                    ad_storage: state,
                    ad_user_data: state,
                    ad_personalization: state,
                    analytics_storage: state,
                  });
                } catch (e) {}
                try { localStorage.setItem(KEY, state); } catch (e) {}
                el.hidden = true;
              });
            }
          }
          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', init);
          } else {
            init();
          }
        })();
      </script>
    </Fragment>
  )
}

<style>
  .consent {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    width: min(40rem, calc(100vw - 2rem));
    z-index: 2147483647;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 1rem 1.15rem;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35);
  }
  .consent__text {
    margin: 0;
    flex: 1 1 18rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .consent__text a {
    color: #fff;
    text-decoration: underline;
  }
  .consent__actions {
    display: flex;
    gap: 0.5rem;
    margin-left: auto;
  }
  .consent__btn {
    border: 0;
    cursor: pointer;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    font: 700 0.85rem/1 var(--font-display, sans-serif);
    background: var(--live);
    color: #fff;
    white-space: nowrap;
  }
  .consent__btn--ghost {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.5);
  }
  .consent__btn:hover {
    filter: brightness(1.08);
  }
</style>
