---
import '../styles/global.css';
import { SECTIONS } from '../content.config';
import { sectionLabel } from '../lib/format';
import { getShows } from '../lib/relations';

interface Props {
  title: string;
  description?: string;
  /** Optional accent to theme the page (e.g. a show's colour). */
  accent?: string;
}

const { title, description, accent } = Astro.props;
const fullTitle = title === 'TV Tattler' ? title : `${title} — TV Tattler`;
const currentPath = Astro.url.pathname;
const shows = await getShows();

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const primaryNav = [
  { href: '/', label: 'Home', accent: false },
  ...SECTIONS.map((s) => ({ href: `/section/${s}/`, label: sectionLabel(s), accent: false })),
  { href: '/shows/', label: 'Shows', accent: false },
  { href: '/kind/spoiler/', label: 'Spoilers', accent: true },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#17122A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="TV Tattler" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body style={accent ? `--accent: ${accent};` : undefined}>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <!-- Utility strip: reference-first tagline + quick links to the kinds -->
      <div class="utility">
        <div class="container utility__inner">
          <span class="utility__tag mono">Reference-first UK entertainment</span>
          <nav class="utility__links mono" aria-label="Quick links">
            <a href="/kind/spoiler/">Spoilers</a>
            <a href="/kind/cast-change/">Cast changes</a>
            <a href="/kind/guide/">Guides</a>
            <a href="/about/">About</a>
          </nav>
        </div>
      </div>

      <!-- Masthead: the wordmark on a light band -->
      <div class="masthead">
        <div class="container masthead__inner">
          <a href="/" class="wordmark" aria-label="TV Tattler home">
            <span class="wordmark__tv">TV</span><span class="wordmark__tattler">Tattler</span>
          </a>
          <p class="masthead__strap">Complete, maintained reference pages for every UK soap, show, character and actor.</p>
          <form class="masthead__search" role="search" action="/search/" method="get">
            <label class="sr-only" for="masthead-q">Search TV Tattler</label>
            <input id="masthead-q" name="q" type="search" placeholder="Search shows, characters…" autocomplete="off" />
            <button type="submit" aria-label="Search">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                <circle cx="11" cy="11" r="7"></circle>
                <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
              </svg>
            </button>
          </form>
        </div>
      </div>

      <!-- Primary navigation: sticky bar -->
      <nav class="mainnav" aria-label="Primary">
        <div class="container mainnav__inner">
          <ul>
            {
              primaryNav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={{ 'nav-spoiler': item.accent }}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.accent && <span class="nav-spoiler__dot" aria-hidden="true">⚠</span>}
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </header>

    <main id="main" class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__grid">
        <div class="site-footer__brand">
          <p class="wordmark wordmark--footer">
            <span class="wordmark__tv">TV</span><span class="wordmark__tattler">Tattler</span>
          </p>
          <p class="site-footer__about">
            A soaps-first UK entertainment site built on evergreen reference depth:
            complete, accurate pages for every show, character and actor — kept up to date.
          </p>
        </div>

        <nav class="site-footer__col" aria-label="Sections">
          <h2 class="site-footer__h">Sections</h2>
          <ul>
            {SECTIONS.map((s) => <li><a href={`/section/${s}/`}>{sectionLabel(s)}</a></li>)}
          </ul>
        </nav>

        <nav class="site-footer__col" aria-label="Browse">
          <h2 class="site-footer__h">Browse</h2>
          <ul>
            <li><a href="/shows/">All shows</a></li>
            <li><a href="/kind/spoiler/">Spoilers</a></li>
            <li><a href="/kind/cast-change/">Cast changes</a></li>
            <li><a href="/kind/guide/">Guides</a></li>
            <li><a href="/kind/feature/">Features</a></li>
            <li><a href="/search/">Search</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/rss.xml">RSS feed</a></li>
          </ul>
        </nav>

        {
          shows.length > 0 && (
            <nav class="site-footer__col" aria-label="Shows">
              <h2 class="site-footer__h">Shows</h2>
              <ul>
                {shows.map((show) => (
                  <li>
                    <a href={`/shows/${show.id}/`}>
                      <span class="dot" style={`--accent: ${show.data.accent};`} aria-hidden="true" />
                      {show.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
      <div class="site-footer__base">
        <div class="container site-footer__base-inner mono">
          <span>© {new Date().getFullYear()} TV Tattler</span>
          <span>Reference depth for UK soaps, telly &amp; celebrity.</span>
        </div>
      </div>
    </footer>

    <style>
      /* ---- Utility strip ------------------------------------------------- */
      .utility {
        background: #0f0b1c;
        color: var(--ink-40);
      }
      .utility__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) var(--space-4);
        padding-block: var(--space-2);
        font-size: var(--step--1);
      }
      .utility__links {
        display: flex;
        gap: var(--space-4);
      }
      .utility__links a {
        color: var(--ink-40);
        text-decoration: none;
      }
      .utility__links a:hover {
        color: #fff;
      }

      /* ---- Masthead ------------------------------------------------------ */
      .masthead {
        background: var(--card);
        border-bottom: 1px solid var(--line);
      }
      .masthead__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-5);
        padding-block: var(--space-4);
      }
      .masthead__strap {
        align-self: baseline;
      }

      /* Search box in the masthead — a GET form so it works without JS
         (the /search/ page filters live once loaded). */
      .masthead__search {
        margin-left: auto;
        display: flex;
        align-items: stretch;
        border: 2px solid var(--line-strong);
        border-radius: 999px;
        overflow: hidden;
        background: var(--card);
      }
      .masthead__search:focus-within {
        border-color: var(--live);
      }
      .masthead__search input {
        border: none;
        background: transparent;
        padding: var(--space-2) var(--space-3);
        font-family: var(--font-body);
        font-size: var(--step-0);
        color: var(--ink);
        min-width: 12rem;
      }
      .masthead__search input:focus {
        outline: none;
      }
      .masthead__search button {
        border: none;
        background: var(--ink);
        color: #fff;
        padding-inline: var(--space-3);
        display: grid;
        place-items: center;
        cursor: pointer;
      }
      .masthead__search button:hover {
        background: var(--live);
      }
      @media (max-width: 30rem) {
        .masthead__search {
          margin-left: 0;
          width: 100%;
        }
        .masthead__search input {
          flex: 1;
          min-width: 0;
        }
      }
      .wordmark {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: var(--step-3);
        letter-spacing: -0.02em;
        text-decoration: none;
        color: var(--ink);
        display: inline-flex;
        align-items: baseline;
        gap: 0.28em;
        line-height: 1;
      }
      .wordmark__tv {
        background: var(--live);
        color: #fff;
        padding: 0.1em 0.28em;
        border-radius: var(--radius-sm);
      }
      .masthead__strap {
        margin: 0;
        color: var(--ink-60);
        font-size: var(--step-0);
        max-width: 40ch;
      }

      /* ---- Primary nav (sticky) ----------------------------------------- */
      .mainnav {
        background: var(--ink);
        position: sticky;
        top: 0;
        z-index: 50;
        box-shadow: var(--shadow-sm);
      }
      .mainnav__inner {
        overflow-x: auto;
        scrollbar-width: none;
      }
      .mainnav__inner::-webkit-scrollbar {
        display: none;
      }
      .mainnav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        gap: var(--space-1);
      }
      .mainnav a {
        display: inline-flex;
        align-items: center;
        gap: 0.35em;
        white-space: nowrap;
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--step-0);
        color: var(--paper);
        text-decoration: none;
        padding: var(--space-3) var(--space-4);
        border-bottom: 3px solid transparent;
      }
      .mainnav a:hover {
        background: rgba(255, 255, 255, 0.08);
      }
      .mainnav a[aria-current='page'] {
        border-bottom-color: var(--live);
        background: rgba(255, 255, 255, 0.06);
      }
      /* The Spoilers link stands out in amber. */
      .mainnav a.nav-spoiler {
        color: var(--spoiler);
        font-weight: 700;
      }
      .mainnav a.nav-spoiler:hover {
        background: color-mix(in srgb, var(--spoiler) 22%, transparent);
      }
      .mainnav a.nav-spoiler[aria-current='page'] {
        border-bottom-color: var(--spoiler);
      }
      .nav-spoiler__dot {
        font-size: 0.9em;
      }

      /* ---- Main ---------------------------------------------------------- */
      .site-main {
        padding-block: var(--space-6) var(--space-8);
        min-height: 60vh;
      }

      /* ---- Footer -------------------------------------------------------- */
      .site-footer {
        background: var(--ink);
        color: var(--paper);
        margin-top: var(--space-8);
      }
      .site-footer__grid {
        display: grid;
        gap: var(--space-6);
        padding-block: var(--space-7);
        grid-template-columns: 1fr;
      }
      @media (min-width: 40rem) {
        .site-footer__grid {
          grid-template-columns: 1.5fr 1fr 1fr;
        }
      }
      @media (min-width: 60rem) {
        .site-footer__grid {
          grid-template-columns: 2fr 1fr 1fr 1.2fr;
        }
      }
      .site-footer__about {
        color: var(--ink-40);
        max-width: 42ch;
        margin: var(--space-3) 0 0;
        font-size: var(--step-0);
      }
      .wordmark--footer {
        margin: 0;
        color: var(--paper);
      }
      .site-footer__h {
        font-family: var(--font-mono);
        font-size: var(--step--1);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--ink-40);
        margin: 0 0 var(--space-3);
      }
      .site-footer__col ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: var(--space-2);
      }
      .site-footer__col a {
        color: var(--paper);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
      }
      .site-footer__col a:hover {
        text-decoration: underline;
      }
      .dot {
        width: 0.6em;
        height: 0.6em;
        border-radius: 999px;
        background: var(--accent);
        flex: none;
      }
      .site-footer__base {
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }
      .site-footer__base-inner {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--space-2);
        padding-block: var(--space-4);
        color: var(--ink-40);
        font-size: var(--step--1);
      }
    </style>
  </body>
</html>
