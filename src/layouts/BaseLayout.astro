---
import '../styles/global.css';
import { SECTIONS } from '../content.config';
import { sectionLabel } from '../lib/format';

interface Props {
  title: string;
  description?: string;
  /** Optional accent to theme the page (e.g. a show's colour). */
  accent?: string;
}

const { title, description, accent } = Astro.props;
const fullTitle = title === 'TV Tattler' ? title : `${title} — TV Tattler`;
const currentPath = Astro.url.pathname;

function isActiveSection(section: string): boolean {
  return currentPath.startsWith(`/section/${section}`);
}
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#17122A" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body style={accent ? `--accent: ${accent};` : undefined}>
    <a href="#main" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container site-header__inner">
        <a href="/" class="wordmark" aria-label="TV Tattler home">
          <span class="wordmark__tv">TV</span><span class="wordmark__tattler">Tattler</span>
        </a>
        <nav class="site-nav" aria-label="Sections">
          <ul>
            {
              SECTIONS.map((section) => (
                <li>
                  <a
                    href={`/section/${section}/`}
                    aria-current={isActiveSection(section) ? 'page' : undefined}
                  >
                    {sectionLabel(section)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="container site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container site-footer__inner">
        <p class="wordmark wordmark--footer">
          <span class="wordmark__tv">TV</span><span class="wordmark__tattler">Tattler</span>
        </p>
        <p class="mono">Reference depth for UK soaps, telly &amp; celebrity.</p>
      </div>
    </footer>

    <style>
      /* ---- Header -------------------------------------------------------- */
      .site-header {
        background: var(--ink);
        color: var(--paper);
        position: sticky;
        top: 0;
        z-index: 50;
        border-bottom: 3px solid var(--accent, var(--live));
      }
      .site-header__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) var(--space-4);
        padding-block: var(--space-3);
      }

      .wordmark {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: var(--step-1);
        letter-spacing: -0.02em;
        text-decoration: none;
        color: inherit;
        display: inline-flex;
        align-items: baseline;
        gap: 0.28em;
        line-height: 1;
      }
      .wordmark__tv {
        background: var(--live);
        color: #fff;
        padding: 0.12em 0.3em;
        border-radius: var(--radius-sm);
      }
      .wordmark__tattler {
        color: inherit;
      }

      /* ---- Nav ----------------------------------------------------------- */
      .site-nav ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-4);
      }
      .site-nav a {
        font-family: var(--font-display);
        font-weight: 600;
        font-size: var(--step-0);
        color: var(--paper);
        text-decoration: none;
        padding: var(--space-1) 0;
        border-bottom: 2px solid transparent;
        display: inline-block;
      }
      .site-nav a:hover {
        border-bottom-color: var(--paper);
      }
      .site-nav a[aria-current='page'] {
        border-bottom-color: var(--live);
      }

      /* ---- Main ---------------------------------------------------------- */
      .site-main {
        padding-block: var(--space-6) var(--space-8);
        min-height: 60vh;
      }

      /* ---- Footer -------------------------------------------------------- */
      .site-footer {
        background: var(--ink);
        color: var(--paper);
        margin-top: var(--space-8);
      }
      .site-footer__inner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-3);
        padding-block: var(--space-6);
      }
      .wordmark--footer {
        margin: 0;
        color: var(--paper);
      }
      .site-footer .mono {
        color: var(--ink-40);
        margin: 0;
      }
    </style>
  </body>
</html>
