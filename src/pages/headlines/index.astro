---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { headlines, freshness } from '../../lib/feeds';
import { getShows } from '../../lib/relations';

const shows = await getShows();
const showBySlug = new Map(shows.map((s) => [s.id, s]));

const items = headlines.items ?? [];
const updated = freshness(headlines.generatedAt);

function ago(iso: string | null): string | null {
  if (!iso) return null;
  const then = new Date(iso).getTime();
  if (Number.isNaN(then)) return null;
  const mins = Math.round((Date.now() - then) / 60000);
  if (mins < 60) return `${Math.max(1, mins)}m ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs}h ago`;
  const days = Math.round(hrs / 24);
  return `${days}d ago`;
}
---

<BaseLayout
  title="Headlines — soap news from around the web"
  description="The latest soap headlines aggregated from across the web, linking straight to each source."
>
  <header class="pagehead">
    <p class="mono pagehead__kicker">News</p>
    <h1>Soap headlines</h1>
    <p class="pagehead__intro">
      The latest soap stories from across the web, gathered automatically and
      linking straight to each source. Headlines only — tap through to read the
      full story where it was published.
    </p>
    {updated && <p class="mono pagehead__stamp">Updated {updated}</p>}
  </header>

  {
    items.length === 0 ? (
      <div class="empty card">
        <h2>The headlines feed is warming up</h2>
        <p>
          This page aggregates soap headlines from the RSS feeds listed in
          <code>src/data/feeds/news-sources.json</code>. Once the daily
          <code>refresh-feeds</code> workflow runs, the latest stories appear here,
          each linking out to its source.
        </p>
      </div>
    ) : (
      <ul class="heads">
        {items.map((h) => {
          const show = h.soap ? showBySlug.get(h.soap) : undefined;
          return (
            <li class="head card" style={show ? `--accent: ${show.data.accent};` : undefined}>
              <div class="head__meta mono">
                {show && (
                  <a class="head__soap" href={`/shows/${show.id}/`}>
                    <span class="head__dot" aria-hidden="true" />
                    {show.data.title}
                  </a>
                )}
                <span class="head__source">{h.source}</span>
                {ago(h.publishedAt) && <span class="head__time">· {ago(h.publishedAt)}</span>}
              </div>
              <a class="head__title" href={h.url} rel="external noopener nofollow">
                {h.title}
              </a>
            </li>
          );
        })}
      </ul>
    )
  }

  <p class="heads-note mono">
    TV Tattler links to these stories; it does not host them. All headlines and
    articles remain the property of their publishers.
  </p>
</BaseLayout>

<style>
  .pagehead {
    border-bottom: 4px solid var(--ink);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-6);
  }
  .pagehead__kicker { color: var(--ink-40); margin-bottom: var(--space-2); }
  .pagehead__intro { color: var(--ink-80); max-width: var(--measure); font-size: var(--step-1); margin-bottom: var(--space-2); }
  .pagehead__stamp { color: var(--ink-40); margin: 0; }

  .empty { padding: var(--space-6); text-align: center; max-width: 46rem; margin-inline: auto; }
  .empty h2 { font-size: var(--step-1); }
  .empty p { color: var(--ink-60); margin: 0 auto; max-width: 48ch; }
  .empty code { font-family: var(--font-mono); font-size: 0.85em; background: var(--paper); padding: 0.1em 0.35em; border-radius: var(--radius-sm); }

  .heads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .head {
    border-left: 4px solid var(--accent, var(--line-strong));
    padding: var(--space-3) var(--space-4);
    display: grid;
    gap: var(--space-1);
  }
  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5em;
    color: var(--ink-40);
  }
  .head__soap {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: color-mix(in srgb, var(--accent) 72%, var(--ink));
    text-decoration: none;
    font-weight: 500;
  }
  .head__dot { width: 0.6em; height: 0.6em; border-radius: 999px; background: var(--accent); }
  .head__source { color: var(--ink-60); }
  .head__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--ink);
    text-decoration: none;
    text-wrap: balance;
  }
  .head__title:hover { text-decoration: underline; text-decoration-thickness: 2px; }

  .heads-note {
    color: var(--ink-40);
    margin-top: var(--space-6);
    text-align: center;
    max-width: 52ch;
    margin-inline: auto;
  }
</style>
