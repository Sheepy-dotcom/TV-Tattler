---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getShows, charactersForShow } from '../../lib/relations';
import { yearRange } from '../../lib/format';

const shows = await getShows();
const withCounts = await Promise.all(
  shows.map(async (show) => ({
    show,
    characterCount: (await charactersForShow(show.id)).length,
  })),
);
---

<BaseLayout
  title="Shows"
  description="Every show TV Tattler covers, from continuing soaps to one-off drama — with complete character and cast reference."
>
  <header class="shows-head">
    <p class="mono shows-head__kicker">Reference</p>
    <h1>Shows</h1>
    <p class="shows-head__blurb">
      The archive spine of the site. Each show carries its own colour — you will
      see it again on every article, character and timeline that belongs to it.
    </p>
  </header>

  {
    shows.length === 0 ? (
      <div class="empty card">
        <h2>No shows yet</h2>
        <p>The show archive is being built — check back soon.</p>
      </div>
    ) : (
      <ul class="show-grid">
        {withCounts.map(({ show, characterCount }) => (
          <li>
            <a class="show-card" href={`/shows/${show.id}/`} style={`--accent: ${show.data.accent};`}>
              <span class="show-card__bar" aria-hidden="true" />
              <span class="show-card__body">
                <span class="show-card__title">{show.data.title}</span>
                <span class="show-card__meta mono">
                  {show.data.broadcaster} · {yearRange(show.data.startYear, show.data.endYear)}
                </span>
                <span class="show-card__summary">{show.data.summary}</span>
                <span class="show-card__count mono">
                  {characterCount} character{characterCount === 1 ? '' : 's'}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .shows-head {
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 4px solid var(--live);
  }
  .shows-head__kicker {
    color: var(--ink-40);
    margin-bottom: var(--space-2);
  }
  .shows-head__blurb {
    font-size: var(--step-1);
    color: var(--ink-80);
    max-width: var(--measure);
  }

  .show-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  @media (min-width: 40rem) {
    .show-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .show-card {
    display: grid;
    grid-template-columns: 10px 1fr;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    color: var(--ink);
    height: 100%;
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .show-card:hover {
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }
  .show-card__bar {
    background: var(--accent);
  }
  .show-card__body {
    padding: var(--space-4);
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .show-card__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .show-card__meta {
    color: color-mix(in srgb, var(--accent) 70%, var(--ink));
  }
  .show-card__summary {
    color: var(--ink-80);
  }
  .show-card__count {
    color: var(--ink-40);
    margin-top: var(--space-1);
  }

  .empty {
    padding: var(--space-6);
    text-align: center;
  }
  .empty code {
    font-family: var(--font-mono);
    background: var(--paper);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }
</style>
