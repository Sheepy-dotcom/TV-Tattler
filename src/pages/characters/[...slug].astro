---
import { getCollection, getEntry, getEntries, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import Sidebar from '../../components/Sidebar.astro';
import Widget from '../../components/Widget.astro';
import PortrayalTimeline from '../../components/PortrayalTimeline.astro';
import { articlesForCharacter, timelineForCharacter, charactersForShow } from '../../lib/relations';
import { statusLabel } from '../../lib/format';

export async function getStaticPaths() {
  const characters = await getCollection('characters');
  return characters.map((character) => ({
    params: { slug: character.id },
    props: { character },
  }));
}

const { character } = Astro.props;
const { data } = character;

const show = await getEntry(data.show);
const accent = show?.data.accent ?? '#17122A';

const [family, timeline, articles, { Content }] = await Promise.all([
  getEntries(data.family),
  timelineForCharacter(character),
  articlesForCharacter(character.id),
  render(character),
]);

// Other characters from the same show — the contextual sidebar for this page.
const siblings = (await charactersForShow(data.show.id))
  .filter((c) => c.id !== character.id)
  .sort((a, b) => a.data.name.localeCompare(b.data.name))
  .slice(0, 10);
---

<BaseLayout title={data.name} description={data.summary} accent={accent}>
  <div class="layout">
    <article class="character layout__main">
    <nav class="crumbs mono" aria-label="Breadcrumb">
      <a href="/shows/">Shows</a>
      <span aria-hidden="true">/</span>
      {show && <a href={`/shows/${show.id}/`}>{show.data.title}</a>}
    </nav>

    <header class="character__header">
      <div class="character__chips">
        <span class:list={['chip', 'chip--accent', `status-${data.status}`]}>
          {statusLabel(data.status)}
        </span>
        {show && (
          <a class="chip chip--accent" href={`/shows/${show.id}/`}>
            {show.data.title}
          </a>
        )}
      </div>
      <h1>{data.name}</h1>
      <p class="character__summary">{data.summary}</p>
    </header>

    <div class="character__prose">
      <Content />
    </div>

    <section class="character__section" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading" class="sr-only">Portrayal timeline</h2>
      {
        timeline.bands.length > 0 ? (
          <PortrayalTimeline timeline={timeline} accent={accent} />
        ) : (
          <p class="muted">Casting details for {data.name} are being added.</p>
        )
      }
    </section>

    {
      family.length > 0 && (
        <section class="character__section" aria-labelledby="family-heading">
          <h2 id="family-heading" class="character__h2">Family</h2>
          <ul class="family">
            {family.map((member) => (
              <li>
                <a class="family__link" href={`/characters/${member.id}/`}>
                  {member.data.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      articles.length > 0 && (
        <section class="character__section" aria-labelledby="coverage-heading">
          <h2 id="coverage-heading" class="character__h2">Coverage</h2>
          <ArticleGrid articles={articles} columns={2} />
        </section>
      )
    }
    </article>
    <Sidebar>
      {
        show && siblings.length > 0 && (
          <Widget title={`More from ${show.data.title}`}>
            <ul class="siblings" style={`--accent: ${accent};`}>
              {siblings.map((c) => (
                <li>
                  <a class="siblings__link" href={`/characters/${c.id}/`}>
                    <span class="siblings__dot" aria-hidden="true" />
                    {c.data.name}
                  </a>
                </li>
              ))}
            </ul>
            <a class="siblings__all" href={`/shows/${show.id}/`}>
              All {show.data.title} characters →
            </a>
          </Widget>
        )
      }
    </Sidebar>
  </div>
</BaseLayout>

<style>
  .character {
    max-width: 52rem;
  }

  .crumbs {
    display: flex;
    gap: var(--space-2);
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .crumbs a {
    color: var(--ink-60);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .character__header {
    border-bottom: 5px solid var(--accent);
    padding-bottom: var(--space-4);
    margin-bottom: var(--space-5);
  }
  .character__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }
  .character__chips a {
    text-decoration: none;
  }
  .status-deceased {
    opacity: 0.85;
  }
  .character__summary {
    font-size: var(--step-1);
    color: var(--ink-80);
    max-width: var(--measure);
  }

  .character__prose {
    max-width: var(--measure);
    margin-bottom: var(--space-6);
  }
  .character__prose:empty {
    display: none;
  }

  .character__section {
    margin-top: var(--space-6);
  }
  .character__h2 {
    font-size: var(--step-2);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--line);
    margin-bottom: var(--space-4);
  }

  .family {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .family__link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-sm);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
  }
  .family__link:hover {
    box-shadow: var(--shadow-sm);
  }

  /* ---- "More from [show]" contextual sidebar widget -------------------- */
  .siblings {
    list-style: none;
    margin: 0 0 var(--space-3);
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .siblings__link {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .siblings__link:hover {
    background: var(--paper);
  }
  .siblings__dot {
    width: 0.55em;
    height: 0.55em;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }
  .siblings__all {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--accent) 72%, var(--ink));
    text-decoration: none;
  }
  .siblings__all:hover {
    text-decoration: underline;
  }

  .muted {
    color: var(--ink-60);
    max-width: var(--measure);
  }
  .muted code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--paper);
    padding: 0.1em 0.35em;
    border-radius: var(--radius-sm);
  }
</style>
