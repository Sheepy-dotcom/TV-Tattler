---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrid from '../../components/ArticleGrid.astro';
import ShowRail from '../../components/ShowRail.astro';
import Sidebar from '../../components/Sidebar.astro';
import { SECTIONS } from '../../content.config';
import { articlesInSection, showsInSection } from '../../lib/relations';
import { sectionMeta, kindLabel } from '../../lib/format';

export async function getStaticPaths() {
  return SECTIONS.map((section) => ({ params: { section } }));
}

const { section } = Astro.params;
const meta = sectionMeta(section);
const label = meta.label;
const articles = await articlesInSection(section as (typeof SECTIONS)[number]);
const shows = await showsInSection(section as (typeof SECTIONS)[number]);

// Kinds actually present in this section, so the filter chips never lead
// to an empty page.
const kindsPresent = [...new Set(articles.map((a) => a.data.kind))].sort();
---

<BaseLayout title={label} description={meta.blurb || `${label} on TV Tattler.`}>
  <header class="section-head" style={`--cat: ${meta.color};`}>
    <p class="mono section-head__kicker">Section</p>
    <h1 class="section-head__title">
      <span class="section-head__emoji" aria-hidden="true">{meta.emoji}</span>
      {label}
    </h1>
    <p class="section-head__blurb">{meta.blurb}</p>

    {
      kindsPresent.length > 1 && (
        <nav class="kind-filter" aria-label="Filter by kind">
          {kindsPresent.map((k) => (
            <a class="chip" href={`/kind/${k}/`}>
              {kindLabel(k)}
            </a>
          ))}
        </nav>
      )
    }
  </header>

  <ShowRail shows={shows} title={`${label} we cover`} />

  <div class="layout">
    <div class="layout__main">
      <h2 class="rail-title" style={`--cat: ${meta.color};`}>Latest in {label}</h2>
      <ArticleGrid
        articles={articles}
        withHero
        columns={2}
        emptyMessage={`No ${label} articles just yet — check back soon.`}
      />
    </div>
    <Sidebar />
  </div>
</BaseLayout>

<style>
  .section-head {
    margin-bottom: var(--space-6);
    padding: var(--space-5) var(--space-5) var(--space-4);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--cat) 10%, white);
    border: 1px solid color-mix(in srgb, var(--cat) 30%, white);
    border-left: 8px solid var(--cat);
  }
  .section-head__kicker {
    color: color-mix(in srgb, var(--cat) 65%, var(--ink));
    margin-bottom: var(--space-2);
  }
  .section-head__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: color-mix(in srgb, var(--cat) 45%, var(--ink));
  }
  .section-head__emoji {
    font-size: 0.9em;
  }
  .section-head__blurb {
    font-size: var(--step-1);
    color: var(--ink-80);
    max-width: var(--measure);
    margin-bottom: var(--space-4);
  }
  .kind-filter {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .kind-filter a {
    text-decoration: none;
  }
  .kind-filter a:hover {
    border-color: var(--ink);
  }

  .rail-title {
    font-size: var(--step-2);
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--cat, var(--live));
    display: inline-block;
  }

  .layout {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 1fr 20rem;
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
