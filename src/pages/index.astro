---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCard from '../components/HeroCard.astro';
import StoryCard from '../components/StoryCard.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import {
  getArticles,
  getShows,
  getShowLookup,
  posterForArticle,
} from '../lib/relations';
import { yearRange } from '../lib/format';

const articles = await getArticles();
const shows = await getShows();
const lookup = await getShowLookup();

// Float the flagged lead to the top; the rest keep newest-first order.
const leadIndex = articles.findIndex((a) => a.data.lead);
const ordered =
  leadIndex > 0
    ? [articles[leadIndex], ...articles.slice(0, leadIndex), ...articles.slice(leadIndex + 1)]
    : articles;

const lead = ordered[0];
const secondary = ordered.slice(1, 3); // side column beside the hero
const latest = ordered.slice(3); // the grid below

const leadPoster = lead ? posterForArticle(lead, lookup) : undefined;
---

<BaseLayout
  title="TV Tattler"
  description="A soaps-first UK entertainment site: complete, accurate reference pages for every show, character and actor, kept up to date."
>
  {
    articles.length === 0 ? (
      <ArticleGrid
        articles={articles}
        emptyMessage="Add a markdown file to src/content/articles/ and it will appear here."
      />
    ) : (
      <>
        <section class="lead-band" aria-label="Top stories">
          {lead && leadPoster && (
            <div class="lead-band__main">
              <HeroCard article={lead} accent={leadPoster.accent} showTitle={leadPoster.showTitle} />
            </div>
          )}
          {secondary.length > 0 && (
            <aside class="lead-band__side">
              <h2 class="rail-title">More top stories</h2>
              <div class="rail">
                {secondary.map((article) => {
                  const p = posterForArticle(article, lookup);
                  return (
                    <StoryCard
                      article={article}
                      accent={p.accent}
                      showTitle={p.showTitle}
                      variant="compact"
                    />
                  );
                })}
              </div>
            </aside>
          )}
        </section>

        {shows.length > 0 && (
          <nav class="shows-strip" aria-label="Browse by show">
            <span class="shows-strip__label mono">Browse by show</span>
            <ul>
              {shows.map((show) => (
                <li>
                  <a class="show-pill" href={`/shows/${show.id}/`} style={`--accent: ${show.data.accent};`}>
                    <span class="show-pill__dot" aria-hidden="true" />
                    {show.data.title}
                    <span class="show-pill__years mono">{yearRange(show.data.startYear, show.data.endYear)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        {latest.length > 0 && (
          <section class="latest" aria-labelledby="latest-heading">
            <h2 id="latest-heading" class="rail-title rail-title--major">Latest</h2>
            <ArticleGrid articles={latest} columns={3} />
          </section>
        )}
      </>
    )
  }
</BaseLayout>

<style>
  /* ---- Hero band: big lead + secondary column -------------------------- */
  .lead-band {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }
  @media (min-width: 60rem) {
    .lead-band {
      grid-template-columns: 1.7fr 1fr;
      gap: var(--space-5);
      align-items: start;
    }
  }

  .lead-band__side {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .rail {
    display: grid;
    gap: var(--space-3);
  }

  .rail-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--live);
    display: inline-block;
  }
  .rail-title--major {
    font-size: var(--step-2);
  }

  /* ---- Browse-by-show strip -------------------------------------------- */
  .shows-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-4);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    margin-bottom: var(--space-7);
  }
  .shows-strip__label {
    color: var(--ink-40);
  }
  .shows-strip ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .show-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.45em 0.8em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 10%, white);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, white);
    color: color-mix(in srgb, var(--accent) 80%, var(--ink));
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
  }
  .show-pill:hover {
    background: color-mix(in srgb, var(--accent) 18%, white);
    border-color: var(--accent);
  }
  .show-pill__dot {
    width: 0.7em;
    height: 0.7em;
    border-radius: 999px;
    background: var(--accent);
  }
  .show-pill__years {
    color: var(--ink-40);
    font-size: 0.75em;
  }

  .latest {
    margin-top: var(--space-6);
  }
</style>
