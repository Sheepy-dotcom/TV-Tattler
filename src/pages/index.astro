---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCard from '../components/HeroCard.astro';
import StoryCard from '../components/StoryCard.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import Sidebar from '../components/Sidebar.astro';
import { getArticles, getShowLookup, posterForArticle } from '../lib/relations';

const articles = await getArticles();
const lookup = await getShowLookup();

// Float the flagged lead to the top; the rest keep newest-first order.
const leadIndex = articles.findIndex((a) => a.data.lead);
const ordered =
  leadIndex > 0
    ? [articles[leadIndex], ...articles.slice(0, leadIndex), ...articles.slice(leadIndex + 1)]
    : articles;

const lead = ordered[0];
const secondary = ordered.slice(1, 3);
const latest = ordered.slice(1); // full feed for the main column (minus the hero)

const leadPoster = lead ? posterForArticle(lead, lookup) : undefined;
---

<BaseLayout
  title="TV Tattler"
  description="A soaps-first UK entertainment site: complete, accurate reference pages for every show, character and actor, kept up to date."
>
  {
    articles.length === 0 ? (
      <ArticleGrid
        articles={articles}
        emptyMessage="Add a markdown file to src/content/articles/ and it will appear here."
      />
    ) : (
      <>
        <section class="lead-band" aria-label="Top stories">
          {lead && leadPoster && (
            <div class="lead-band__main">
              <HeroCard article={lead} accent={leadPoster.accent} showTitle={leadPoster.showTitle} />
            </div>
          )}
          {secondary.length > 0 && (
            <div class="lead-band__side">
              <h2 class="rail-title">More top stories</h2>
              <div class="rail">
                {secondary.map((article) => {
                  const p = posterForArticle(article, lookup);
                  return (
                    <StoryCard
                      article={article}
                      accent={p.accent}
                      showTitle={p.showTitle}
                      variant="compact"
                    />
                  );
                })}
              </div>
            </div>
          )}
        </section>

        <div class="layout">
          <div class="layout__main">
            <h2 class="rail-title rail-title--major">Latest</h2>
            <ArticleGrid articles={latest} columns={2} />
          </div>
          <Sidebar />
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  /* ---- Hero band: big lead + secondary column -------------------------- */
  .lead-band {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  @media (min-width: 60rem) {
    .lead-band {
      grid-template-columns: 1.9fr 1fr;
      gap: var(--space-5);
      align-items: start;
    }
  }
  .lead-band__side {
    align-content: start;
  }
  .rail {
    display: grid;
    gap: var(--space-3);
  }

  .rail-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 3px solid var(--live);
    display: inline-block;
  }
  .rail-title--major {
    font-size: var(--step-2);
  }

  /* ---- Main + sidebar layout ------------------------------------------- */
  .layout {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 1fr 20rem;
      gap: var(--space-7);
      align-items: start;
    }
  }
</style>
