---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleStack from '../components/ArticleStack.astro';
import { getArticles } from '../lib/relations';

const articles = await getArticles();

// The lead is the first article flagged `lead`, floated to the top; the rest
// keep their newest-first order.
const leadIndex = articles.findIndex((a) => a.data.lead);
const ordered =
  leadIndex > 0
    ? [articles[leadIndex], ...articles.slice(0, leadIndex), ...articles.slice(leadIndex + 1)]
    : articles;
---

<BaseLayout
  title="TV Tattler"
  description="A soaps-first UK entertainment site: complete, accurate reference pages for every show, character and actor, kept up to date."
>
  <p class="home__kicker mono">UK soaps · telly · celebrity</p>

  <ArticleStack
    articles={ordered}
    withLead
    emptyMessage="Add a markdown file to src/content/articles/ and it will appear here, newest first. Set lead: true on one to give it the large slot."
  />
</BaseLayout>

<style>
  .home__kicker {
    margin-bottom: var(--space-4);
    color: var(--ink-60);
  }
</style>
