---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCard from '../components/HeroCard.astro';
import StoryCard from '../components/StoryCard.astro';
import ArticleGrid from '../components/ArticleGrid.astro';
import ShowRail from '../components/ShowRail.astro';
import Sidebar from '../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { getArticles, getShows, getShowLookup, posterForArticle } from '../lib/relations';
import { factsForPerson, resolveEntityImage } from '../lib/wikidata';
import { SECTIONS } from '../content.config';
import { sectionMeta } from '../lib/format';
import { upcomingEpisodes, films } from '../lib/feeds';

const articles = await getArticles();
const shows = await getShows();
const lookup = await getShowLookup();

// A rail of cast faces for the homepage — only people who actually have a photo,
// so it's a wall of real faces rather than monograms.
const people = await getCollection('people');
const castAvatars = people
  .map((person) => {
    const facts = factsForPerson(person.id);
    const hasPhoto = Boolean(person.data.image || facts?.imageSuggestion?.imageLocal);
    const portrait = resolveEntityImage({
      image: person.data.image,
      imageAlt: person.data.imageAlt,
      imageCredit: person.data.imageCredit,
      useWikidataImage: person.data.useWikidataImage,
      name: person.data.name,
      facts,
    });
    return { person, hasPhoto, src: portrait?.src };
  })
  .filter((x) => x.hasPhoto && x.src)
  .sort((a, b) => a.person.data.name.localeCompare(b.person.data.name))
  .slice(0, 20);

// Live feeds for the homepage: the next few soap episodes and new films. All
// come from the auto-refreshed data files and simply don't render when empty.
const accentOf = new Map(shows.map((s) => [s.id, s.data.accent]));
const nextEpisodes = upcomingEpisodes().slice(0, 5);
const newFilms = (films.items ?? []).slice(0, 6);

function epDay(iso: string): string {
  const d = new Date(iso + 'T00:00:00');
  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const diff = Math.round((d.getTime() - today.getTime()) / 86400000);
  if (diff === 0) return 'Today';
  if (diff === 1) return 'Tomorrow';
  return d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' });
}

// Float the flagged lead to the top; the rest keep newest-first order.
const leadIndex = articles.findIndex((a) => a.data.lead);
const ordered =
  leadIndex > 0
    ? [articles[leadIndex], ...articles.slice(0, leadIndex), ...articles.slice(leadIndex + 1)]
    : articles;

const lead = ordered[0];
const secondary = ordered.slice(1, 3);
const latest = ordered.slice(1); // full feed for the main column (minus the hero)

const leadPoster = lead ? posterForArticle(lead, lookup) : undefined;
---

<BaseLayout
  title="TV Tattler"
  description="A soaps-first UK entertainment site: complete, accurate reference pages for every show, character and actor, kept up to date."
>
  {
    articles.length === 0 ? (
      <ArticleGrid
        articles={articles}
        emptyMessage="Add a markdown file to src/content/articles/ and it will appear here."
      />
    ) : (
      <>
        <section class="lead-band" aria-label="Top stories">
          {lead && leadPoster && (
            <div class="lead-band__main">
              <HeroCard article={lead} accent={leadPoster.accent} showTitle={leadPoster.showTitle} />
            </div>
          )}
          {secondary.length > 0 && (
            <div class="lead-band__side">
              <h2 class="rail-title">More top stories</h2>
              <div class="rail">
                {secondary.map((article) => {
                  const p = posterForArticle(article, lookup);
                  return (
                    <StoryCard
                      article={article}
                      accent={p.accent}
                      showTitle={p.showTitle}
                      variant="compact"
                    />
                  );
                })}
              </div>
            </div>
          )}
        </section>

        {
          nextEpisodes.length > 0 && (
            <section class="whatson" aria-label="What's on this week">
              <div class="whatson__head">
                <h2 class="rail-title"><span class="livedot" aria-hidden="true" />On this week</h2>
                <a class="whatson__all" href="/whats-on/">Full schedule →</a>
              </div>
              <ul class="whatson__list">
                {nextEpisodes.map((ep) => (
                  <li class="whatson__ep" style={`--accent: ${accentOf.get(ep.showSlug) ?? 'var(--ink)'};`}>
                    <a class="whatson__link" href="/whats-on/">
                      <span class="whatson__when mono">{epDay(ep.airdate)}</span>
                      <span class="whatson__show">
                        <span class="whatson__dot" aria-hidden="true" />
                        {ep.showName}
                      </span>
                      <span class="whatson__syn">{ep.summary || 'Synopsis to follow.'}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <nav class="cats" aria-label="Browse by section">
          {
            SECTIONS.map((s) => {
              const m = sectionMeta(s);
              return (
                <a class="cat" href={`/section/${s}/`} style={`--cat: ${m.color};`}>
                  <span class="cat__emoji" aria-hidden="true">{m.emoji}</span>
                  <span class="cat__label">{m.label}</span>
                </a>
              );
            })
          }
        </nav>

        {
          newFilms.length > 0 && (
            <section class="filmrail" aria-label="New and upcoming films">
              <div class="whatson__head">
                <h2 class="rail-title">In cinemas &amp; coming soon</h2>
                <a class="whatson__all" href="/films/">All films →</a>
              </div>
              <ul class="filmrail__track">
                {newFilms.map((film) => (
                  <li class="filmrail__item">
                    <a href="/films/" class="filmrail__link">
                      <span class="filmrail__poster">
                        {film.poster ? (
                          <img src={film.poster} alt="" loading="lazy" decoding="async" />
                        ) : (
                          <span class="filmrail__noposter">{film.title}</span>
                        )}
                      </span>
                      <span class="filmrail__title">{film.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <ShowRail
          shows={shows}
          title="The shows — every one on record"
          href="/shows/"
          hrefLabel="All shows"
        />

        {
          castAvatars.length >= 8 && (
            <section class="castrail" aria-label="The cast">
              <div class="whatson__head">
                <h2 class="rail-title">Meet the cast</h2>
                <a class="whatson__all" href="/people/">All cast &rarr;</a>
              </div>
              <ul class="castrail__track">
                {castAvatars.map(({ person, src }) => (
                  <li class="castrail__item">
                    <a class="castrail__link" href={`/people/${person.id}/`}>
                      <span class="castrail__avatar">
                        <img src={src} alt={person.data.name} loading="lazy" decoding="async" />
                      </span>
                      <span class="castrail__name">{person.data.name}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <div class="layout">
          <div class="layout__main">
            <h2 class="rail-title rail-title--major">Latest stories</h2>
            <ArticleGrid articles={latest} columns={2} />
          </div>
          <Sidebar />
        </div>
      </>
    )
  }
</BaseLayout>

<style>
  /* ---- Hero band: big lead + secondary column -------------------------- */
  .lead-band {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  @media (min-width: 60rem) {
    .lead-band {
      grid-template-columns: 1.9fr 1fr;
      gap: var(--space-5);
      align-items: start;
    }
  }
  .lead-band__side {
    align-content: start;
  }
  .rail {
    display: grid;
    gap: var(--space-3);
  }

  .rail-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    display: inline-block;
    background-image: var(--grad-brand);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 3px;
  }
  .rail-title--major {
    font-size: var(--step-2);
  }

  /* ---- Main + sidebar layout ------------------------------------------- */
  .layout {
    display: grid;
    gap: var(--space-6);
  }
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: 1fr 20rem;
      gap: var(--space-7);
      align-items: start;
    }
  }

  /* ---- "On this week" strip -------------------------------------------- */
  .whatson,
  .filmrail {
    margin-bottom: var(--space-7);
  }
  .whatson__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .whatson__all {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    color: color-mix(in srgb, var(--live) 80%, var(--ink));
    text-decoration: none;
    white-space: nowrap;
  }
  .whatson__all:hover {
    text-decoration: underline;
  }
  .whatson__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  .whatson__ep {
    background: var(--card);
    border: 1px solid var(--line);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .whatson__ep:hover {
    box-shadow: var(--shadow);
    transform: translateY(-1px);
  }
  .whatson__link {
    display: grid;
    grid-template-columns: 6.5rem 10rem 1fr;
    gap: var(--space-3);
    align-items: baseline;
    padding: var(--space-3) var(--space-4);
    text-decoration: none;
    color: var(--ink);
  }
  .whatson__when {
    color: color-mix(in srgb, var(--accent) 72%, var(--ink));
  }
  .whatson__show {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-weight: 600;
  }
  .whatson__dot {
    width: 0.6em;
    height: 0.6em;
    border-radius: 999px;
    background: var(--accent);
    flex: none;
  }
  .whatson__syn {
    color: var(--ink-60);
    font-size: var(--step--1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (max-width: 44rem) {
    .whatson__link {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .whatson__syn {
      white-space: normal;
    }
  }

  /* ---- Live pulse dot -------------------------------------------------- */
  .livedot {
    display: inline-block;
    width: 0.55em;
    height: 0.55em;
    margin-right: 0.5em;
    border-radius: 999px;
    background: var(--live);
    vertical-align: middle;
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--live) 60%, transparent);
    animation: livepulse 2s ease-out infinite;
  }
  @keyframes livepulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--live) 55%, transparent); }
    70% { box-shadow: 0 0 0 0.5em transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .livedot { animation: none; }
  }

  /* ---- Films rail (horizontal posters) --------------------------------- */
  .filmrail__track {
    list-style: none;
    margin: 0;
    padding: 0 0 var(--space-2);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 9rem;
    gap: var(--space-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .filmrail__link {
    text-decoration: none;
    color: var(--ink);
    display: grid;
    gap: var(--space-2);
  }
  .filmrail__poster {
    display: block;
    aspect-ratio: 2 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--ink);
    box-shadow: var(--shadow-sm);
    position: relative;
  }
  .filmrail__poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease);
  }
  .filmrail__link:hover .filmrail__poster img {
    transform: scale(1.05);
  }
  .filmrail__noposter {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: var(--space-2);
    text-align: center;
    color: var(--paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step--1);
  }
  .filmrail__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.25;
  }

  /* ---- Cast avatar rail ------------------------------------------------ */
  .castrail {
    margin-bottom: var(--space-7);
  }
  .castrail__track {
    list-style: none;
    margin: 0;
    padding: var(--space-2) 0 var(--space-3);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 5.5rem;
    gap: var(--space-4);
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .castrail__link {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: var(--ink);
    text-align: center;
  }
  .castrail__avatar {
    display: block;
    width: 5rem;
    height: 5rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--paper);
    border: 3px solid var(--card);
    box-shadow: 0 0 0 1px var(--line-strong), var(--shadow-sm);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .castrail__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }
  .castrail__link:hover .castrail__avatar {
    transform: translateY(-3px);
    box-shadow: 0 0 0 2px var(--live), var(--shadow);
  }
  .castrail__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1.2;
  }

  /* ---- Fun, colourful category buttons --------------------------------- */
  .cats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }
  @media (min-width: 44rem) {
    .cats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .cat {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--cat) 12%, white);
    border: 2px solid color-mix(in srgb, var(--cat) 35%, white);
    text-decoration: none;
    color: color-mix(in srgb, var(--cat) 82%, var(--ink));
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.12s ease;
  }
  .cat:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    background: color-mix(in srgb, var(--cat) 18%, white);
    border-color: var(--cat);
  }
  .cat__emoji {
    font-size: 1.6em;
    line-height: 1;
  }
</style>
